<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<Authors>electr0sheep</Authors>
		<Description>Tune into in-game housing radio stations. Custom music for FFXIV clubs.</Description>
		<Version>0.1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="NSec.Cryptography" Version="26.4.0" />
		<PackageReference Include="NLayer" Version="1.16.0" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
	</ItemGroup>

	<ItemGroup>
		<!-- EFF long diceware wordlist (CC BY 3.0). 7776 words, ~106 KB.
		     Used by Network/Passphrase.cs to generate club passphrases. -->
		<EmbeddedResource Include="Resources/eff_large_wordlist.txt" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
	</ItemGroup>

</Project>
